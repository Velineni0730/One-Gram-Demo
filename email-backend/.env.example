# ================================================================
# ONE GRAM DEMO — EMAIL BACKEND ENVIRONMENT CONFIGURATION
# ================================================================
# Copy this file to ".env" for LOCAL development.
# On Render, add each variable under:
# Web Service -> Environment -> Add Environment Variable.
#
# Render service configuration:
#   Root Directory: email-backend  (if this folder is inside your main repo)
#   Build Command: npm install
#   Start Command: npm start
#
# NEVER commit your real .env file. NEVER put RESEND_API_KEY in Vercel,
# React code, a VITE_ variable, GitHub, or a browser request.

# ---------------- REQUIRED: RESEND API KEY ----------------
# Create an API key at https://resend.com/api-keys.
# Paste the full secret key here / into Render's value field.
# It usually starts with "re_". Keep it private.
RESEND_API_KEY=

# ---------------- REQUIRED: SENDER EMAIL ----------------
# The sender domain must be verified in Resend.
# Example after verifying your own domain:
# Demo Jewellery Store <invoices@yourdomain.com>
# Use an address/domain that Resend has approved for sending.
EMAIL_FROM=

# ---------------- REQUIRED: FRONTEND URL ----------------
# Your deployed React/Vite app origin; no trailing slash and no page path.
FRONTEND_URL=https://1-gram-demo.vercel.app

# ---------------- REQUIRED: CORS ALLOWED ORIGINS ----------------
# Comma-separated browser origins. Add production and local Vite origins.
# No trailing slash; do not include /billing or any other route.
CORS_ORIGINS=https://1-gram-demo.vercel.app,http://localhost:5173,http://localhost:5174

# ---------------- OPTIONAL LIMITS ----------------
# Maximum recipients accepted in one bulk-email API request.
# Each recipient is emailed separately to keep addresses private.
MAX_RECIPIENTS=20

# Maximum API requests per IP per minute (basic in-memory limit).
MAX_REQUESTS_PER_MINUTE=30

# Maximum combined PDF/other attachment size per request, in MB.
MAX_ATTACHMENT_MB=10

# Render assigns PORT automatically. Usually leave this commented out.
# Local default is 10000.
# PORT=10000

# ================================================================
# FRONTEND SETTING — SET IN VERCEL, NOT IN THIS BACKEND FILE
# ================================================================
# Vercel -> Project -> Settings -> Environment Variables:
# VITE_EMAIL_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/send-email
# Replace YOUR-RENDER-SERVICE with the hostname Render gives your service.
# This URL is public; that is expected. The Resend secret is NOT public.
