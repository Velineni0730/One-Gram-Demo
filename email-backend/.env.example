# One Gram Demo email backend environment variables
# Add these in Render -> Web Service -> Environment.
# Keep the real secret out of GitHub and out of Vercel/frontend code.

# REQUIRED: Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# REQUIRED: sender address whose domain is verified in Resend.
# Example: Demo Jewellery Store <invoices@yourdomain.com>
EMAIL_FROM=

# REQUIRED: deployed frontend origin (no trailing slash)
FRONTEND_URL=https://1-gram-demo.vercel.app

# REQUIRED: comma-separated allowed browser origins
CORS_ORIGINS=https://1-gram-demo.vercel.app,http://localhost:5173,http://localhost:5174

# OPTIONAL: Render supplies PORT automatically; local default is 10000
# PORT=10000

# FRONTEND VARIABLE — set this in Vercel, not Render:
# VITE_EMAIL_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api/send-email
# Replace YOUR-RENDER-SERVICE with the actual Render service hostname.
# Never put RESEND_API_KEY in Vercel or any VITE_ variable.
